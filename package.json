{
  "name": "aikanpan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI 看盘助手：本地行情、K线指标、预警、持仓盈亏与 AI 分析",
  "author": "AIkanpan",
  "main": "out/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/start.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.build.json",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:web && npm run build:server",
    "build:desktop": "npm run build && npm run build:electron",
    "dev:desktop": "npm run build:desktop && electron .",
    "dist:win": "npm run build:desktop && electron-builder --win nsis --x64",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.electron.json",
    "start": "node out/server/start.js"
  },
  "dependencies": {
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "klinecharts": "^9.8.12",
    "openai": "^7.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  }
}
